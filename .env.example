SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# true = login em memória (sem Supabase). Contas: tecnico@kym.test,
# gestor@kym.test, lojista@kym.test — senha: kym12345
USE_FAKE_AUTH=false

# Deep link que abre a tela de nova senha. O mesmo valor precisa estar em
# Authentication > URL Configuration > Redirect URLs no Supabase.
PASSWORD_RESET_REDIRECT_URL=br.edu.ifpe.mobile.kym://reset-password
# Client ID do cliente OAuth "Aplicativo da Web" (Google Cloud), o mesmo
# cadastrado em Authentication > Providers > Google no Supabase.
# Vazio desativa o login com Google.
GOOGLE_WEB_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxx.apps.googleusercontent.com
